# Read by scripts/fetch.sh.
#
# Releases published before this moment are ignored. Their Flatpak bundles were built before
# degenview/degenview put releases on the `stable` and `beta` branches (PR 382), so they are on
# `master` and cannot be installed from this repo. Set it to the publish time of the first release
# built with channels.
SINCE_PUBLISHED_AT="2026-11-09T00:00:00Z"
